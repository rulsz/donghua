{
  "rewrites": [
    { "source": "/api/donghua", "destination": "/api/donghua.js" },
    { "source": "/api/movie", "destination": "/api/movie.js" },
    { "source": "/api/detail", "destination": "/api/detail.js" },
    { "source": "/api/search", "destination": "/api/search.js" },
    { "source": "/detail/(.*)", "destination": "/detail.html?slug=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
