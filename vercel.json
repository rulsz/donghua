{
  "rewrites": [
    { "source": "/api/donghua", "destination": "/api/donghua.js" },
    { "source": "/api/detail", "destination": "/api/detail.js" },
    { "source": "/api/search", "destination": "/api/search.js" },
    { "source": "/api/settings", "destination": "/api/settings.js" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/detail/:slug*", "destination": "/detail.html?slug=:slug*" }
  ]
}
